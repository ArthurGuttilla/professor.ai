# ─── Banco de dados ─────────────────────────────────────────────
# PostgreSQL. Ex.: postgresql://user:pass@localhost:5432/professor_ai
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/professor_ai?schema=public"

# ─── IA (Anthropic) ─────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# Modelo para raciocínio pesado: geração de plano/prova, correção por rubrica.
AI_MODEL_HEAVY="claude-opus-4-8"
# Modelo para tarefas de custo/latência menores: formatação, rerank, tutor rápido.
AI_MODEL_LIGHT="claude-haiku-4-5-20251001"

# ─── Auth (a integrar na Fase 1) ────────────────────────────────
# AUTH_SECRET=""
# NEXTAUTH_URL="http://localhost:3000"

# ─── Storage de uploads (a integrar na Fase 2) ──────────────────
# Slides publicados, PDFs/PPTX do professor, scans de provas.
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ─── App ────────────────────────────────────────────────────────
# URL pública usada para gerar QR codes de materiais (M4/M8).
APP_URL="http://localhost:3000"

# ─── Storage local (v1) ─────────────────────────────────────────
# Diretório de uploads (materiais, scans de provas). Default: ./storage
# STORAGE_DIR=""
